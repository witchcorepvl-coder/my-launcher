{
  "name": "pavlovsk-craft-launcher",
  "version": "1.0.0",
  "description": "PavlovskCraft Launcher",
  "author": "witchcore",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.witchcore.pavlovskcraft",
    "productName": "PavlovskCraft",
    "copyright": "witchcore",
    "icon": "icon.png",
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "fonts/**/*",
      "audio/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "PavlovskCraft.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "dmg": {
      "artifactName": "PavlovskCraft-${arch}.dmg",
      "title": "PavlovskCraft",
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
