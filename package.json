{
  "name": "pvl-craft-launcher",
  "version": "2.0.0",
  "description": "Лаунчер сервера PVL Craft",
  "author": "witchcore",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dir --arm64 --x64 --publish never && node build/make-dmg.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "extract-zip": "^2.0.1",
    "skinview3d": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.witchcore.pavlovskcraft",
    "productName": "PavlovskCraft",
    "copyright": "witchcore",
    "icon": "assets/icon.png",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "PavlovskCraft.exe",
      "requestExecutionLevel": "admin"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
